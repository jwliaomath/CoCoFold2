#!/usr/bin/env bash
# Copy this file to env.sh and replace every placeholder/path before running.

export COCOFOLD2_ROOT=/absolute/path/to/CoCoFold2
export PROTENIX_ROOT_DIR=/absolute/path/to/protenix_resources
export DATA_ROOT=/absolute/path/to/data/6zbh
export PARAMS_ROOT="${COCOFOLD2_ROOT}/params"
export OUTPUT_ROOT="${COCOFOLD2_ROOT}/outputs"
export LOG_ROOT="${COCOFOLD2_ROOT}/logs"

export INPUT_JSON="${DATA_ROOT}/input/6zbh.json"
export STAR_FILE="${DATA_ROOT}/particles/366.star"
export MRC_ROOT="${DATA_ROOT}/particles/"
export PROTENIX_SAMPLE_CIF="TODO_PROTENIX_SAMPLE_CIF"
export FITTED_INITIAL_CIF="${DATA_ROOT}/fitted/6zbh_fitted.cif"
export DIFFUSION_DATA="${PARAMS_ROOT}/6zbh_diffusion_data.pth"
# Replace after checking the map header and fitted CIF frame. For a zero-origin
# 288^3 map at 1.073 A/pixel, its geometric center is 154.512 A on each axis.
export PROJECTION_ORIGIN_X=154.512
export PROJECTION_ORIGIN_Y=154.512
export PROJECTION_ORIGIN_Z=154.512

export USE_TRANS_R=1
export USE_UPDATE_AFFINE_MAT=1
